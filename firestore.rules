rules_version = '2';

// Seuls les comptes Google listés ici peuvent lire et modifier les données.
// Remplacez les adresses par celles des associés, puis collez ce fichier dans
// Firebase > Firestore Database > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {
    function estAssocie() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'associe1@gmail.com',
          'associe2@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if estAssocie();
    }
  }
}
