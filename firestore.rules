rules_version = '2';

// Seuls les comptes listés ici peuvent lire et modifier les données.
// Les identifiants (UID) se trouvent dans Firebase > Authentication > Utilisateurs,
// colonne « Identifiant utilisateur ». Collez ce fichier dans
// Firebase > Firestore Database > Règles, puis cliquez sur Publier.
service cloud.firestore {
  match /databases/{database}/documents {
    function estAssocie() {
      return request.auth != null
        && request.auth.uid in [
          'COLLER_UID_ASSOCIE_1',
          'COLLER_UID_ASSOCIE_2'
        ];
    }

    match /{document=**} {
      allow read, write: if estAssocie();
    }
  }
}
